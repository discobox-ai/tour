#!/bin/bash
# Runs in the box's primary terminal, before its chosen harness.
#
# A full-screen tour, driven by keyboard or mouse, drawn in the discobox design
# language (brand/LANGUAGE.md in discobox-ai/discobox): the terminal's own
# ground, one magenta accent for focus, one gold title band per view, state
# glyphs beside words. Colours are the tokens' xterm-256
# values; truecolour is used only for the mark and the accent. Plain Bash.
#
# Exit status: 0 after Continue (the harness starts), 1 after Exit or EOF,
# 130 on Ctrl-C, 143 on TERM. Anything but 0 leaves a shell for recovery.
set -u

state_dir="$HOME/.local/state/discobox-tour"
replay=0
if [[ ${1-} == --replay ]]; then replay=1; fi
if (( ! replay )) && [[ -f $state_dir/completed ]]; then
  exit 0
fi
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)

if [[ ! -t 0 || ! -t 1 ]]; then
  printf 'The Discobox tour needs a terminal. Your harness has not started.\n' >&2
  printf 'Replay with: .discobox/scripts/pre-harness --replay\n' >&2
  exit 1
fi

# Widths below count characters, so the locale must be UTF-8.
case ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} in
  *[Uu][Tt][Ff]-8* | *[Uu][Tt][Ff]8*) ;;
  *) export LC_ALL=C.UTF-8 ;;
esac

# ── Palette: roles from the brand tokens ─────────────────────────────────────
E=$'\e'
R="${E}[0m" BOLD="${E}[1m"
if [[ -n ${NO_COLOR-} ]]; then
  ACC='' MARK='' GOLD='' LINE='' LINEB='' MUTED='' FAINT=''
  GREEN='' ERR=''
  BAND="${E}[7m" SEL="${E}[7m" SECT="${E}[7m" BTN='' BTNF="${E}[7m"
else
  case ${COLORTERM-} in
    truecolor | 24bit) ACC="${E}[38;2;244;92;255m" MARK="${E}[38;2;158;74;167m" ;;
    *) ACC="${E}[38;5;207m" MARK="${E}[38;5;133m" ;;
  esac
  GOLD="${E}[38;5;220m"            # title band, keys, cursor chevron
  BAND="${E}[48;5;220;38;5;232m"   # gold band, on-gold text
  LINE="${E}[38;5;236m"            # quiet frames
  LINEB="${E}[38;5;238m"           # dividers that must show
  MUTED="${E}[38;5;245m" FAINT="${E}[38;5;240m"
  GREEN="${E}[38;5;120m" ERR="${E}[38;5;196m"
  SEL="${E}[48;5;237m"             # the cursor row
  SECT="${E}[48;5;236m$MUTED"      # section band
  BTN="${E}[48;5;236m" BTNF="${E}[48;5;238m"
fi

# The discobox mark, a block-element capture of brand/logo-purple.svg.
LOGO=(
  '█▄'
  '██'
  '██   ▄▄'
  ' ▀███▀▀███▄▄▄▄'
  '  ██  ▄▄   ▀▀▀▀███▄▄'
  '  ██  ██▀ ▄▄▄ ▄▄  ▀█▄'
  '   █▄    ▀▀▀▀ ██▀ ▄█▀'
  '   ▀██▄          ▄███▄'
  '  ▄██████▄▄▄▄▄▄▄██  ██'
  ' ████████▀▀▀███████▄▀▀'
  ' ████████   ▀███████▄'
  '  ██████▀     ███████'
)

# ── Tour state ───────────────────────────────────────────────────────────────
# Chapters in order: a slug says which body build_content draws, a title names it.
slugs=('' box window shell console tools ssh ports desktop access audit harness leave)
titles=('' 'What this box is' 'The window' 'Open a shell' 'The console' 'Tools' 'SSH and Git' 'Ports'
  'The desktop' 'Secrets and requests' 'Audit' 'Harnesses' 'Leaving and returning')
NCH=$(( ${#slugs[@]} - 1 ))
items=() visited=(0)
for (( i = 1; i <= NCH; i++ )); do items+=("$i") visited+=(0); done
items+=(c q)
screen=welcome      # welcome | main
view=list           # narrow screens show one pane: list | content
focus=list          # list | content
bfocus=-1           # focused button in the content pane, -1 for none
cursor=0 sel=1 cscroll=0 reveal=0 CV=(0 0) BLINE=()
hover='' rows=24 cols=80 narrow=0 resized=0
# This box's ID, for commands the reader can copy; its name works too.
box_id=BOX
if [[ -r /etc/discobox/sandbox.json ]]; then
  json=$(</etc/discobox/sandbox.json)
  re='"sandboxId"[[:space:]]*:[[:space:]]*"([^"]+)"'
  if [[ $json =~ $re ]]; then box_id=${BASH_REMATCH[1]}; fi
fi
# Whether this box has the desktop: ready, provisioning, pending, failed, off.
desktop_state=''
if [[ -r /run/discobox/provision.json ]]; then
  json=$(</run/discobox/provision.json)
  re='"desktop"[[:space:]]*:[[:space:]]*\{[[:space:]]*"state"[[:space:]]*:[[:space:]]*"([a-z]+)"'
  if [[ $json =~ $re ]]; then desktop_state=${BASH_REMATCH[1]}; fi
fi
unset json re
audit_state=none audit_failed=0 audit_rec=()
site_state=none site_port='' site_note=''
request_id='' access_state=none access_note='' access_out='' access_err=''

# ── Terminal ─────────────────────────────────────────────────────────────────
tty_on=0
tty_init() {
  saved_stty=$(stty -g)
  stty -echo -icanon -ixon min 1 time 0
  # Alternate screen, hidden cursor, SGR mouse with motion for hover.
  printf '%s' "${E}[?1049h${E}[?25l${E}[?1000h${E}[?1003h${E}[?1006h"
  tty_on=1
}
tty_restore() {
  (( tty_on )) || return 0
  tty_on=0
  printf '%s' "${E}[?1006l${E}[?1003l${E}[?1000l${E}[0m${E}[?25h${E}[?1049l"
  stty "$saved_stty" 2>/dev/null
}
finish() {
  local code=$1 line
  shift
  tty_restore
  for line in "$@"; do printf '%s\n' "$line"; done
  exit "$code"
}
term_size() {
  local size
  size=$(stty size 2>/dev/null) || size='24 80'
  rows=${size% *} cols=${size#* }
  narrow=$(( cols < 78 ))
  if (( narrow )) && [[ $focus == content ]]; then view=content; else view=list; fi
}
# A signal only sets a flag: exiting inside the trap would let an interrupted
# read restore the raw terminal mode after tty_restore had undone it.
sig=0
trap 'sig=130' INT
trap 'sig=143' TERM
check_signal() {
  case $sig in
    130) finish 130 '' 'Tour interrupted. Your harness has not started.' ;;
    143) finish 143 ;;
  esac
}
trap 'resized=1' WINCH
trap tty_restore EXIT

# ── Drawing helpers ──────────────────────────────────────────────────────────
rep() { local n=$2; if (( n < 0 )); then n=0; fi; printf -v REPLY '%*s' "$n" ''; REPLY=${REPLY// /$1}; }
at() { out+="${E}[$1;$2H"; }
region() { HY+=("$1") HX1+=("$2") HX2+=("$3") HA+=("$4"); }

# Inline markup in prose: {ctrl+a_s} is a key (gold), *word* is bold, and _
# inside either is a space. Sets REPLY.
ink() {
  local s=$1 base=$2 o='' t rest inner re='^([^{*]*)([{*])(.*)$'
  while [[ $s =~ $re ]]; do
    o+=${BASH_REMATCH[1]} t=${BASH_REMATCH[2]} rest=${BASH_REMATCH[3]}
    if [[ $t == '{' ]]; then
      inner=${rest%%\}*} rest=${rest#*\}}
      o+="$GOLD${inner//_/ }$R$base"
    else
      inner=${rest%%\**} rest=${rest#*\*}
      o+="$BOLD${inner//_/ }$R$base"
    fi
    s=$rest
  done
  REPLY=$base$o$s$R
}

# Word-wrap $1 to $2 columns, not counting markup. Sets WR.
wrap() {
  local w=$2 line='' lv=0 word v wv words
  WR=()
  read -ra words <<< "$1"
  for word in "${words[@]}"; do
    v=${word//[\{\}\*]/} wv=${#v}
    if (( lv == 0 )); then line=$word lv=$wv
    elif (( lv + 1 + wv <= w )); then line+=" $word" lv=$((lv + 1 + wv))
    else WR+=("$line") line=$word lv=$wv
    fi
  done
  if (( lv )); then WR+=("$line"); fi
}

frame() { # x y w h title focused [bottom-note]
  local x=$1 y=$2 w=$3 h=$4 title=$5 f=$6 note=${7-} c bc tc r
  if (( f )); then c=$ACC bc=$ACC tc=$BOLD; else c=$LINE bc=$MUTED tc=$MUTED; fi
  rep ─ $(( w - 7 - ${#title} )); local fill=$REPLY
  at "$y" "$x"; out+="$c╭─${bc}[ $R$tc$title$R$bc ]$c$fill╮$R"
  for (( r = 1; r < h - 1; r++ )); do
    at $(( y + r )) "$x"; out+="$c│$R"
    at $(( y + r )) $(( x + w - 1 )); out+="$c│$R"
  done
  rep ─ $(( w - 2 )); at $(( y + h - 1 )) "$x"; out+="$c╰$REPLY╯$R"
  if [[ -n $note ]]; then
    at $(( y + h - 1 )) $(( x + w - 3 - ${#note} )); out+="$FAINT $note $R"
  fi
}

band() { # left right
  local left=" $1" right="$2 "
  rep ' ' $(( cols - ${#left} - ${#right} ))
  at 1 1; out+="$BAND$BOLD$left$REPLY$right$R"
}

visited_count() {
  local i n=0
  for (( i = 1; i <= NCH; i++ )); do n=$(( n + visited[i] )); done
  REPLY=$n
}

# ── Content: what each chapter says ──────────────────────────────────────────
# RAW lines are typed by their first word: e (eyebrow), p (prose with markup),
# t (plain text, wrapped), c (command), s (pre-styled status), - (blank).
para() { RAW+=("p $1"); }
code() { RAW+=("c $1"); }
gap() { RAW+=('-'); }
# A status line: a coloured glyph, a word, and a muted note cut to fit.
stat() { RAW+=("g $1"$'\x1f'"$2"$'\x1f'"$3"$'\x1f'"${4-}"); }
button() { BL+=("$1") BA+=("$2") BP+=("${3:-0}"); }
next_button() {
  if (( $1 < NCH )); then button "Next: ${titles[$1 + 1]}" "go:$(( $1 + 1 ))" 1
  else button 'Ready? Continue' go:c 1
  fi
}

build_content() {
  RAW=() BL=() BA=() BP=()
  case $sel in
    [1-9] | [1-9][0-9]) RAW+=("e CHAPTER $sel OF $NCH" '-') ;;
  esac
  local slug=$sel
  if [[ $sel =~ ^[0-9]+$ ]]; then slug=${slugs[sel]}; fi
  case $slug in
    box)
      para 'A box is a Linux environment of its own, with its own home directory and a copy of your source. Commands here run in the box, not on your machine. Your agent works here too.'
      gap
      para 'Stopping and restarting a box keeps your work. Detaching leaves programs running. An idle box can power off on its own.'
      gap
      para 'Commits made here do not change your original checkout. Push work to a Git remote before you archive a box: a box is not your only backup.'
      gap
      para 'No production credentials are needed. Try the chapters in any order.'
      gap
      RAW+=("s ${MUTED}This tour's checkout$R")
      code "$root"
      next_button "$sel"
      ;;
    window)
      para 'Discobox draws the window around this tour: the panes, their tabs and the bars along the edges. Everything in it is clickable. Click a pane or a tab to focus it, and click the keys a pane'\''s border shows to use them.'
      gap
      para 'The keyboard goes through one leader key, {ctrl+a}. Press it, release it, then press one more key: {ctrl+a_s} opens a shell, {ctrl+a_o} the tools, {ctrl+a_d} detaches. Every other key goes to the program in the focused pane, ctrl+c included.'
      gap
      para 'You need not remember the keys. {ctrl+a_.} opens the palette: every action available where you are. Choose one with the arrows and {enter}, or click it. {F1} opens help anywhere.'
      gap
      para 'You should rarely need it, but if the mouse misbehaves in a pane, {ctrl+a_m} turns mouse capture off and on again.'
      gap
      para 'The leader can be another ctrl key or an alt key, anything but ctrl+c. Set DISCOBOX_LEADER on your host before you open the window, or pass *--leader*:'
      gap
      code 'DISCOBOX_LEADER=alt+a discobox console'
      code 'discobox console --leader ctrl+b'
      next_button "$sel"
      ;;
    shell)
      para 'Press {ctrl+a_s} to open a shell beside this menu. In that shell, run:'
      gap
      code "printf 'Hello from my box!\\n' > tour-note.txt"
      code 'cat tour-note.txt'
      code 'git status --short'
      gap
      para 'The file is a harmless change to this box'\''s copy. Keep it, or remove it with *rm_tour-note.txt*.'
      gap
      para 'Type *exit* to close the shell, or click this menu to come back. The extra shell skips the tour, so this menu stays where you left it.'
      next_button "$sel"
      ;;
    console)
      para 'This window opened straight into this box. The full console holds every box you have. Press {ctrl+a_._l}: the palette, then l for the list of boxes. It is the same screen *discobox_console* opens on your host:'
      gap
      code 'discobox console'
      gap
      para 'The list shows all your boxes, on every server you use, running or stopped, with the branch and commit each one is on. Move with the arrows, then press {enter} to attach or {s} for a shell. {t} and {T} stop and start a box, {e} renames it and {x} archives it. {?} lists every key.'
      gap
      para 'Type a prompt at the top of the list and press {enter} to start a new box from it. Switching boxes leaves their sessions running, and {ctrl+a_q} quits the window without stopping anything.'
      next_button "$sel"
      ;;
    tools)
      para 'Press {ctrl+a_o} to open the tools picker. Choose a tool that runs in the box, such as the Git viewer, and try it. Close the tool to come back here. {esc} closes the picker without choosing.'
      gap
      para 'The picker also offers host editors when they are configured. VS Code or Zed runs on your machine and connects to this box. An editor is optional.'
      gap
      para 'The picker also shows this box'\''s Git URL; the next chapter puts it to use. If no suitable tool is installed, you can still finish this tour.'
      next_button "$sel"
      ;;
    ssh)
      para 'Your box speaks SSH, and it is already set up: launching a box adds it to your host'\''s ~/.ssh/config. Connect from your host by the box'\''s name or ID. There is no sshd in the box and no key to copy: Discobox carries the session.'
      gap
      code "ssh $box_id"
      gap
      para '*scp*, *rsync* and VS Code Remote-SSH work the same way. If your SSH config ever falls out of step with your boxes, resync it on your host:'
      gap
      code 'discobox admin ssh-config --write'
      gap
      para 'The box is a Git remote too. The tools picker, {ctrl+a_o}, shows its URL, which looks like this:'
      gap
      code "ssh://$box_id$root"
      gap
      para 'Add it to a checkout on your host to fetch what is committed here, without pushing it anywhere else first:'
      gap
      code "git remote add box ssh://$box_id$root"
      code 'git fetch box'
      next_button "$sel"
      ;;
    ports)
      para 'While you are attached, every port a program listens on in this box is forwarded to your host on its own. It gets the same number on your *localhost* when that is free, otherwise the nearest one above. Ports below 1024 add 8000, so 80 becomes 8080.'
      gap
      para 'Try it with a small website that runs in the background.'
      site_refresh
      if [[ $site_state != none ]]; then gap; fi
      case $site_state in
        none) button 'Start a website' site 1 ;;
        running)
          stat "$GREEN" ● running "a website on port $site_port"
          gap
          para "Click the *Ports* link in the window: the website is listed there with the port it got on your host. Click it, or open *localhost:$site_port* in a browser on your host."
          gap
          para 'When you are not attached, forward the ports yourself. On your host, run this; it forwards every port the box listens on, as they appear, until you stop it:'
          gap
          code "discobox proxy $box_id"
          gap
          para 'The website keeps running after the tour, until the box stops. Stop it here, or later with:'
          gap
          code 'kill "$(cat ~/.local/state/discobox-tour/site.pid)"'
          button 'Stop the website' sitestop
          ;;
        error)
          stat "$ERR" ✗ "$site_note"
          button 'Try again' site
          ;;
      esac
      if [[ $site_state != running ]]; then
        gap
        para 'When you are not attached, forward the ports from your host:'
        gap
        code "discobox proxy $box_id"
      fi
      next_button "$sel"
      ;;
    desktop)
      para 'A box can have a graphical desktop: Xfce, with Chromium, a terminal and a file manager. Open *localhost:6900* in a browser on your host to see it. It is a web page, forwarded like any other port, so there is no VNC client to install. The *Discobox* link at the top or bottom of the window opens it too.'
      gap
      para 'Your agent can open pages there and take screenshots, so the two of you look at the same screen. In the viewer you can mark a region and leave a note on it, and your agent can read your notes.'
      case $desktop_state in
        ready) gap; stat "$GREEN" ✓ ready 'this box has the desktop' ;;
        pending | provisioning) gap; stat "$GOLD" ◐ installing 'the desktop is still being set up' ;;
        failed) gap; stat "$ERR" ✗ failed 'the desktop did not install in this box' ;;
        off) gap; stat "$FAINT" ○ off 'this project turned the desktop off'
             gap; para 'A project turns it back on in *.discobox/settings.json*.' ;;
      esac
      next_button "$sel"
      ;;
    access) build_access ;;
    audit) build_audit ;;
    harness)
      para 'Your harness is the program you chose before opening this box. Choose *Continue* when you are ready. An agent may ask you to sign in; the shell harness returns to a shell. The tour needs no agent subscription and no sign-in.'
      gap
      para 'Sign in and adjust agent settings inside a box. When the green *changes_to_save* band appears, press {ctrl+a_H} to review what will be saved for future boxes. Review it carefully before you save or discard.'
      gap
      para 'To try a different harness later, stop the box and use its settings in the console. *discobox_configure* sets the default for future boxes. This tour does not change your default or stop this box.'
      next_button "$sel"
      ;;
    leave)
      para 'Press {ctrl+a_d} to detach. On your host, run *discobox_ls* to find this box, then:'
      gap
      code "discobox attach $box_id"
      gap
      para 'That is this box'\''s ID; its name works too. You come back to this same menu. Detaching does not stop the box. From your host you can also run:'
      gap
      code "discobox stop $box_id"
      code "discobox start $box_id"
      gap
      para 'Until you continue, each new primary launch shows this tour again. After you continue, a marker skips it on later starts of this box. To replay it without starting another harness, open a shell and run:'
      gap
      code '.discobox/scripts/pre-harness --replay'
      gap
      para 'When you are finished, collect your work, then archive the box from your host. The tour never archives it for you.'
      gap
      code "discobox rm $box_id"
      next_button "$sel"
      ;;
    c)
      RAW+=('e READY' '-')
      if (( replay )); then
        para 'Finish the tour and return to your shell. No other harness starts.'
      else
        para 'Start your selected harness. Continuing records that you finished the tour, so later starts of this box skip it.'
      fi
      gap
      visited_count
      para "You visited $REPLY of $NCH chapters. None is required."
      if [[ $access_state == pending ]]; then
        gap
        stat "$GOLD" ◐ pending 'the demo request still waits in the host inbox'
      fi
      if (( replay )); then button 'Finish the tour' continue 1
      else button 'Continue to my harness' continue 1
      fi
      ;;
    q)
      RAW+=('e LEAVE' '-')
      para 'Leave the tour for a shell. Your harness does not start, and the tour shows again on the next primary launch.'
      gap
      para 'Replay it any time with:'
      code '.discobox/scripts/pre-harness --replay'
      button 'Exit to a shell' quit
      ;;
  esac
  if (( narrow )); then button 'Back' back; fi
}

build_access() {
  para 'A secret stays outside the box. An approved credential appears here as a stand-in, a sentinel. The egress swaps in the real value only on the routes you approved. Check the host, path and method before you approve.'
  gap
  para 'Try it with a real request for a disposable demo credential. In the host inbox, approve it with a credential named *discobox-tour* whose value is *tour-example-only*, or deny it to see that path. Never choose an account token.'
  gap
  code 'credential  discobox-tour'
  code 'value       tour-example-only'
  code 'route       GET tour.discobox.invalid/demo'
  gap
  para 'No network call uses this value and no delegation is requested. Press {ctrl+a_g} to open the inbox once the request appears. Denying it still finishes the tour.'
  gap
  case $access_state in
    none) button 'Create the demo request' request 1 ;;
    working) stat "$GOLD" ◐ "$access_note" ;;
    pending)
      stat "$GOLD" ◐ pending "request $request_id"
      if [[ -n $access_out ]]; then RAW+=("t $access_out"); fi
      gap
      para 'Answer it in the inbox, then check here, now or later. A request cannot be cancelled from the box: if it is still pending when you are done, deny it in the inbox.'
      button 'Check the request' check 1
      ;;
    approved)
      stat "$GREEN" ✓ approved "request $request_id"
      if [[ -n $access_out ]]; then RAW+=("t $access_out"); fi
      gap
      para 'New commands in this box get a stand-in for it in DISCOBOX_TOUR_TOKEN, never the value itself. The tour sends it nowhere.'
      ;;
    denied)
      stat "$ERR" ✗ denied "request $request_id"
      if [[ -n $access_out ]]; then RAW+=("t $access_out"); fi
      gap
      para 'That is the other path: the box never gets the credential.'
      ;;
    error)
      stat "$ERR" ✗ "$access_note"
      if [[ -n $access_err ]]; then RAW+=("t $access_err"); fi
      if [[ -n $request_id ]]; then button 'Check again' check 1
      else button 'Try again' request 1
      fi
      ;;
  esac
  next_button "$sel"
}

build_audit() {
  para 'Every request this box sends out goes through one egress proxy, and each one is captured in full: the request and the response, headers and bodies. Your agent'\''s requests are in it too, and the record outlives the box.'
  gap
  para 'The audit also holds your harness'\''s hooks, the steps your agent reports as it works, and every secret request with how it was answered.'
  gap
  para 'Open the audit view any time with {ctrl+a_A}.'
  gap
  para 'Make a few harmless requests to *example.com*, a domain reserved for examples, then look at them in the audit view.'
  gap
  case $audit_state in
    none) button 'Make 4 requests' audit 1 ;;
    working) stat "$GOLD" ◐ 'making requests…' ;;
    shown)
      local row
      if (( audit_failed )); then
        stat "$ERR" ✗ "$audit_failed of 4 got no answer" 'the egress may have refused them'
      else
        stat "$GREEN" ✓ 'sent 4 requests' 'to example.com and iana.org'
      fi
      if (( ${#audit_rec[@]} )); then
        gap
        RAW+=("s ${MUTED}What the audit recorded:$R")
        for row in "${audit_rec[@]}"; do code "$row"; done
      fi
      gap
      para 'Press {ctrl+a_A} again: these four are at the top of the audit view, beside everything else this box has sent. From inside the box, the same record is one command away:'
      gap
      code 'discobox-access audit --host example.com'
      gap
      para 'A request the egress refuses is recorded too, with the reason. Look here when a program fails without saying why.'
      button 'Make them again' audit
      ;;
  esac
  next_button "$sel"
}

# Lay RAW out at width $1 into CL. A button row is \x01 then its indices.
layout() {
  local w=$1 line kind text l first rest bw rw=0 i j row=()
  CL=() BLINE=()
  for line in "${RAW[@]}"; do
    kind=${line%% *} text=${line#* }
    case $kind in
      e) CL+=("$ACC$text$R") ;;
      p) wrap "$text" "$w"
         for l in "${WR[@]}"; do ink "$l" ''; CL+=("$REPLY"); done ;;
      t) while IFS= read -r l; do
           wrap "$l" $(( w - 2 ))
           for l in "${WR[@]}"; do CL+=("  $MUTED$l$R"); done
         done <<< "$text" ;;
      c) text=${text:0:w-2} first=${text%% *} rest=${text:${#first}}
         CL+=("$LINEB▎$R $ACC$first$R$rest") ;;
      s) CL+=("$text") ;;
      g) IFS=$'\x1f' read -r first rest l text <<< "$text"   # colour glyph word note
         i=$(( w - 4 - ${#l} ))
         if (( ${#text} > i )); then
           if (( i > 1 )); then text="${text:0:i-1}…"; else text=''; fi
         fi
         CL+=("$first$rest$R $l  $MUTED$text$R") ;;
      *) CL+=('') ;;
    esac
  done
  (( ${#BL[@]} )) || return 0
  if [[ -n ${CL[-1]-} ]]; then CL+=(''); fi
  for i in "${!BL[@]}"; do
    bw=$(( ${#BL[i]} + 4 ))
    if (( rw > 0 && rw + 2 + bw > w - 1 )); then
      CL+=($'\x01'"${row[*]}")
      for j in "${row[@]}"; do BLINE[j]=$(( ${#CL[@]} - 1 )); done
      row=() rw=0
    fi
    row+=("$i") rw=$(( rw + (rw > 0 ? 2 : 0) + bw ))
  done
  CL+=($'\x01'"${row[*]}")
  for j in "${row[@]}"; do BLINE[j]=$(( ${#CL[@]} - 1 )); done
}

draw_buttons() { # y x indices...
  local y=$1 x=$(( $2 + 1 )) i label bg fg on
  shift 2
  for i in "$@"; do
    label="  ${BL[i]}  "
    on=0
    if [[ $focus == content && $bfocus == "$i" ]] || [[ $hover == "btn:$i" ]]; then on=1; fi
    if (( on )); then bg=$BTNF fg=$ACC$BOLD
      at "$y" $(( x - 1 )); out+="$GOLD›$R"
    elif (( BP[i] )); then bg=$BTN fg=$ACC
    else bg=$BTN fg=''
    fi
    at "$y" "$x"; out+="$bg$fg$label$R"
    region "$y" "$x" $(( x + ${#label} - 1 )) "btn:$i"
    x=$(( x + ${#label} + 2 ))
  done
}

draw_list() { # x y w h focused
  local x=$1 y=$2 w=$3 h=$4 f=$5 i r=$(( $2 + 1 )) id glyph key label lc row mark
  frame "$x" "$y" "$w" "$h" chapters "$f"
  for i in "${!items[@]}"; do
    id=${items[i]}
    if [[ $id == c ]]; then
      r=$(( r + 1 ))
      rep ' ' $(( w - 2 - 19 ))
      at "$r" $(( x + 1 )); out+="$SECT ready when you are$REPLY$R"
      r=$(( r + 1 ))
    fi
    case $id in
      c) glyph="$ACC▶$R" key=' c' label='Continue' lc=$ACC
         if (( ! replay )); then label='Continue to my harness'; fi ;;
      q) glyph="$MUTED◁$R" key=' q' label='Exit tour' lc=$MUTED ;;
      *) if (( visited[id] )); then glyph="$GREEN✓$R"; else glyph="$FAINT○$R"; fi
         printf -v key '%2s' "$id"; label=${titles[id]} lc='' ;;
    esac
    if [[ $hover == "item:$i" ]]; then lc=$ACC; fi
    row='' mark=' '
    if (( i == cursor )); then row=$SEL mark="$GOLD›"; fi
    rep ' ' $(( w - 2 - 7 - ${#label} ))
    at "$r" $(( x + 1 ))
    out+="$row$mark$R$row$glyph$row $FAINT$key$R$row  $lc$label$R$row$REPLY$R"
    region "$r" $(( x + 1 )) $(( x + w - 2 )) "item:$i"
    r=$(( r + 1 ))
  done
}

draw_content() { # x y w h focused
  local x=$1 y=$2 w=$3 h=$4 f=$5 ih=$(( $4 - 2 )) tw=$(( $3 - 4 )) max r i line title note=''
  if (( tw > 76 )); then tw=76; fi
  case $sel in
    [1-9] | [1-9][0-9]) title=${titles[sel]} ;;
    c) title=Continue ;;
    q) title='Exit tour' ;;
  esac
  build_content
  layout "$tw"
  max=$(( ${#CL[@]} - ih )); if (( max < 0 )); then max=0; fi
  if (( reveal && bfocus >= 0 )); then
    i=${BLINE[bfocus]:-0}
    if (( i < cscroll )); then cscroll=$i; fi
    if (( i >= cscroll + ih )); then cscroll=$(( i - ih + 1 )); fi
  fi
  reveal=0
  if (( cscroll > max )); then cscroll=$max; fi
  if (( cscroll < 0 )); then cscroll=0; fi
  CV=("$cscroll" "$ih")
  if (( cscroll < max )); then note='↓ more'; fi
  frame "$x" "$y" "$w" "$h" "$title" "$f" "$note"
  if (( cscroll > 0 )); then at "$y" $(( x + w - 10 )); out+="$FAINT ↑ more $R"; fi
  for (( r = 0; r < ih; r++ )); do
    i=$(( cscroll + r ))
    (( i < ${#CL[@]} )) || break
    line=${CL[i]}
    if [[ $line == $'\x01'* ]]; then
      # shellcheck disable=SC2086
      draw_buttons $(( y + 1 + r )) $(( x + 2 )) ${line:1}
    else
      at $(( y + 1 + r )) $(( x + 2 )); out+="$line"
    fi
  done
  CP=("$x" "$y" "$w" "$h")
}

draw_welcome() {
  local bw=$(( cols - 4 )) top lines=() l y x on=0 label='  Begin the tour  '
  if (( bw > 64 )); then bw=64; fi
  band 'discobox tour' ''
  lines+=("e A TOUR OF YOUR BOX" '-' "s ${BOLD}Hi! Welcome to Discobox.$R" '-')
  wrap 'You are inside a box: your own workspace for an agent and its tools. Commands here run in the box, not on your machine.' "$bw"
  for l in "${WR[@]}"; do lines+=("p $l"); done
  lines+=('-')
  wrap 'This tour runs before your selected harness. It needs no agent account; signing in comes when you continue.' "$bw"
  for l in "${WR[@]}"; do lines+=("p $l"); done
  local h=$(( ${#lines[@]} + 2 )) logo=0
  if (( rows >= h + ${#LOGO[@]} + 5 )); then logo=1 h=$(( h + ${#LOGO[@]} + 1 )); fi
  top=$(( (rows - h) / 2 )); if (( top < 2 )); then top=2; fi
  y=$top
  if (( logo )); then
    x=$(( (cols - 22) / 2 + 1 ))
    for l in "${LOGO[@]}"; do at "$y" "$x"; out+="$MARK$l$R"; y=$(( y + 1 )); done
    y=$(( y + 1 ))
  fi
  x=$(( (cols - bw) / 2 + 1 ))
  for l in "${lines[@]}"; do
    case $l in
      e\ *) at "$y" "$x"; out+="$ACC${l#e }$R" ;;
      s\ *) at "$y" "$x"; out+="${l#s }" ;;
      p\ *) at "$y" "$x"; out+="${l#p }" ;;
    esac
    y=$(( y + 1 ))
  done
  y=$(( y + 1 ))
  if [[ $hover == begin || -z $hover ]]; then on=1; fi
  at "$y" "$x"; out+="$GOLD›$R"
  at "$y" $(( x + 1 ))
  if (( on )); then out+="$BTNF$ACC$BOLD$label$R"; else out+="$BTN$ACC$label$R"; fi
  region "$y" $(( x + 1 )) $(( x + ${#label} )) begin
}

draw_small() {
  local msg='Make this window larger' sub='40×19 or more · q exits' y=$(( rows / 2 ))
  at "$y" $(( (cols - ${#msg}) / 2 + 1 )); out+="$GOLD$msg$R"
  at $(( y + 1 )) $(( (cols - ${#sub}) / 2 + 1 )); out+="$FAINT$sub$R"
}

render() {
  out="${E}[?2026h${E}[H${E}[2J"
  HY=() HX1=() HX2=() HA=() LP=() CP=()
  if (( cols < 40 || rows < 19 )); then
    draw_small
  elif [[ $screen == welcome ]]; then
    draw_welcome
  else
    visited_count
    band 'discobox tour' "$REPLY of $NCH visited"
    local h=$(( rows - 1 ))
    if (( narrow )); then
      if [[ $view == list ]]; then
        draw_list 2 2 $(( cols - 2 )) "$h" 1
        LP=(2 2 $(( cols - 2 )) "$h")
      else
        draw_content 2 2 $(( cols - 2 )) "$h" 1
      fi
    else
      draw_list 2 2 32 "$h" "$([[ $focus == list ]] && echo 1 || echo 0)"
      LP=(2 2 32 "$h")
      draw_content 35 2 $(( cols - 35 )) "$h" "$([[ $focus == content ]] && echo 1 || echo 0)"
    fi
  fi
  out+="${E}[?2026l"
  printf '%s' "$out"
}

# ── Actions ──────────────────────────────────────────────────────────────────
show_item() { # index into items
  cursor=$1 sel=${items[$1]} cscroll=0 bfocus=-1
  if [[ $sel =~ ^[0-9]+$ ]]; then visited[sel]=1; fi
}
item_index() { local i; for i in "${!items[@]}"; do [[ ${items[i]} == "$1" ]] && REPLY=$i; done; }
focus_content() {
  build_content
  focus=content bfocus=0
  if (( narrow )); then view=content; fi
}
focus_list() { focus=list bfocus=-1; if (( narrow )); then view=list; fi; }

do_continue() {
  mkdir -p -- "$state_dir" && touch -- "$state_dir/completed" ||
    finish 1 '' 'Could not record the tour as finished. Your harness has not started.'
  if (( replay )); then
    finish 0 '' "$GREEN✓$R Tour complete. Returning to your shell."
  fi
  finish 0 '' "$GREEN✓$R Tour complete. Continuing to your selected harness."
}
do_quit() {
  local msgs=('' 'Tour exited. Your harness has not started.')
  if [[ -n $request_id ]]; then msgs+=('Deny any pending demo request in the host inbox.'); fi
  msgs+=('Replay with: .discobox/scripts/pre-harness --replay')
  finish 1 "${msgs[@]}"
}

create_request() {
  local result
  access_state=working access_note='Creating the request…'
  render
  mkdir -p -- "$state_dir"
  if result=$(discobox-access request --name discobox-tour --env-var DISCOBOX_TOUR_TOKEN \
      --route 'GET tour.discobox.invalid/demo' --ttl 10m \
      --justification 'Learn approval or denial using the disposable value tour-example-only; no account token and no network call' \
      2>"$state_dir/access-error" </dev/null); then
    read -r request_id _ <<< "$result"
    access_state=pending access_out=''
  else
    access_state=error access_note='The request could not be made.'
    access_err=$(<"$state_dir/access-error")
  fi
}
# The Ports chapter's website: python3's static server on a free port from
# 8000, detached so it outlives the tour. state_dir holds site.pid and site.port.
port_open() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }
site_refresh() {
  local pid
  [[ $site_state == error ]] && return 0
  if read -r pid < "$state_dir/site.pid" 2>/dev/null &&
      read -r site_port < "$state_dir/site.port" 2>/dev/null &&
      [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
    site_state=running
  else
    site_state=none
  fi
}
start_site() {
  local port dir=$state_dir/site pid i
  if ! command -v python3 >/dev/null; then
    site_state=error site_note='python3 is not installed in this box'
    return
  fi
  for (( port = 8000; port < 8020; port++ )); do port_open "$port" || break; done
  mkdir -p -- "$dir"
  cat > "$dir/index.html" <<HTML
<!doctype html>
<meta charset="utf-8">
<title>Hello from your box</title>
<style>
  body { margin: 0; min-height: 100vh; display: grid; place-items: center;
    background: #0a0410; color: #f4ecf9;
    font: 16px/1.6 "JetBrains Mono", ui-monospace, Menlo, Consolas, monospace; }
  main { max-width: 34rem; padding: 2rem; }
  .band { background: #ffd700; color: #0a0410; font-weight: 700; padding: 0.15rem 0.6rem; border-radius: 6px; }
  h1 { color: #f45cff; font-size: 1.75rem; margin: 1.5rem 0 0.5rem; }
  code { color: #f45cff; }
  p { color: #b0a0bf; }
</style>
<main>
  <span class="band">discobox tour</span>
  <h1>Hello from your box.</h1>
  <p>This page is served from inside <code>$box_id</code>, on port <code>$port</code>.
  Discobox forwarded that port to your machine, and your browser reached it.</p>
  <p>Go back to the tour and carry on.</p>
</main>
HTML
  setsid python3 -m http.server "$port" --directory "$dir" \
    >"$state_dir/site.log" 2>&1 </dev/null &
  pid=$!
  for (( i = 0; i < 20; i++ )); do
    if port_open "$port"; then
      printf '%s\n' "$pid" > "$state_dir/site.pid"
      printf '%s\n' "$port" > "$state_dir/site.port"
      site_state=running site_port=$port
      return
    fi
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  kill "$pid" 2>/dev/null
  site_state=error site_note='the website did not start'
}
stop_site() {
  local pid
  if read -r pid < "$state_dir/site.pid" 2>/dev/null && [[ $pid =~ ^[0-9]+$ ]]; then
    kill "$pid" 2>/dev/null
  fi
  rm -f -- "$state_dir/site.pid" "$state_dir/site.port"
  site_state=none
}

run_audit() {
  local spec method url code
  audit_state=working
  render
  audit_failed=0 audit_rec=()
  for spec in 'GET https://example.com/' 'GET https://example.com/discobox-tour' \
      'POST https://example.com/' 'GET https://www.iana.org/help/example-domains'; do
    method=${spec%% *} url=${spec#* }
    if [[ $method == POST ]]; then
      code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 8 -A discobox-tour \
        -d 'hello=from-the-tour' "$url" 2>/dev/null </dev/null) || code=${code:-000}
    else
      code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 8 -A discobox-tour \
        "$url" 2>/dev/null </dev/null) || code=${code:-000}
    fi
    if [[ $code == 000 ]]; then audit_failed=$(( audit_failed + 1 )); fi
  done
  # Read them back from the box's own audit: TIME STATUS METHOD URL (DURATION).
  sleep 1
  local status rest
  while read -r _ status method rest; do
    [[ $rest == *example.com* || $rest == *iana.org* ]] || continue
    audit_rec+=("$status  $method ${rest% (*}")
    (( ${#audit_rec[@]} < 4 )) || break
  done < <(discobox-access audit --since 2m --limit 12 2>/dev/null </dev/null)
  audit_state=shown
}
check_request() {
  local rc=0
  access_state=working access_note='Checking the request…'
  render
  access_out=$(discobox-access wait --timeout 1s request "$request_id" \
    2>"$state_dir/access-error" </dev/null) || rc=$?
  access_err=$(<"$state_dir/access-error")
  case $rc in
    0) access_state=approved ;;
    3) access_state=pending ;;
    1) if [[ -n $access_out ]]; then access_state=denied
       else access_state=error access_note='The request could not be checked.'; fi ;;
    *) access_state=error access_note='The request could not be checked.' ;;
  esac
}

press() { # button index
  local a=${BA[$1]}
  case $a in
    go:*) item_index "${a#go:}"; show_item "$REPLY"; focus_content ;;
    continue) do_continue ;;
    quit) do_quit ;;
    request) create_request ;;
    check) check_request ;;
    site) site_state=none; mkdir -p -- "$state_dir"; start_site ;;
    sitestop) stop_site ;;
    audit) run_audit ;;
    back) focus_list ;;
  esac
}

# ── Input ────────────────────────────────────────────────────────────────────
# Sets K to a key name, or K=mouse with MB MX MY MT. Returns 1 on EOF.
read_key() {
  local c s p rc
  K=''
  IFS= read -rsn1 -d '' -t 0.25 c; rc=$?
  if (( rc > 128 )); then K=timeout; return 0; fi
  if (( rc != 0 )); then return 1; fi
  case $c in
    $'\e')
      if ! IFS= read -rsn1 -d '' -t 0.05 c; then K=esc; return 0; fi
      if [[ $c != '[' && $c != O ]]; then K=esc; return 0; fi
      s=''
      while IFS= read -rsn1 -d '' -t 0.05 c; do
        s+=$c
        [[ $c == [A-Za-z~] ]] && break
      done
      case $s in
        '<'*[Mm])
          p=${s:1:${#s}-2} MT=${s: -1}
          MB=${p%%;*} p=${p#*;} MX=${p%%;*} MY=${p#*;} K=mouse ;;
        A) K=up ;; B) K=down ;; C) K=right ;; D) K=left ;;
        H | 1~ | 7~) K=home ;; F | 4~ | 8~) K=end ;;
        5~) K=pgup ;; 6~) K=pgdn ;; Z) K=btab ;;
        *) K=unknown ;;
      esac ;;
    $'\n' | $'\r') K=enter ;;
    $'\t') K=tab ;;
    ' ') K=space ;;
    $'\x0c') K=redraw ;;
    *) K=$c ;;
  esac
}

hit() {
  local i
  HIT=''
  for i in "${!HY[@]}"; do
    if (( HY[i] == $2 && $1 >= HX1[i] && $1 <= HX2[i] )); then HIT=${HA[i]}; return; fi
  done
}
inside() { # x y rect...
  (( $# == 6 )) && (( $1 >= $3 && $1 < $3 + $5 && $2 >= $4 && $2 < $4 + $6 ))
}

move_cursor() {
  local c=$(( cursor + $1 ))
  if (( c < 0 )); then c=0; fi
  if (( c >= ${#items[@]} )); then c=$(( ${#items[@]} - 1 )); fi
  if (( narrow )); then cursor=$c; else show_item "$c"; fi
}
scroll() { cscroll=$(( cscroll + $1 )); }

on_mouse() {
  if (( MB & 64 )); then
    local d=-3; if (( MB & 1 )); then d=3; fi
    if inside "$MX" "$MY" "${LP[@]}"; then move_cursor $(( d / 3 ))
    elif inside "$MX" "$MY" "${CP[@]}"; then scroll "$d"
    fi
    return
  fi
  hit "$MX" "$MY"
  if (( MB & 32 )); then hover=$HIT; return; fi
  [[ $MT == M && $(( MB & 3 )) == 0 ]] || return 0
  case $HIT in
    begin) screen=main; show_item 0 ;;
    item:*) show_item "${HIT#item:}"; focus=list
            if (( narrow )); then focus=content view=content; fi ;;
    btn:*) build_content; press "${HIT#btn:}" ;;
  esac
}

on_key_main() {
  local nb
  case $K in
    c | C) do_continue ;;
    q | Q) do_quit ;;
    [1-9]) item_index "$K"; show_item "$REPLY"; focus_list ;;
    redraw) ;;
    pgup) scroll -10 ;; pgdn) scroll 10 ;;
  esac
  build_content; nb=${#BL[@]}
  if [[ $focus == list ]]; then
    case $K in
      up | k) move_cursor -1 ;;
      down | j) move_cursor 1 ;;
      home) move_cursor -99 ;; end) move_cursor 99 ;;
      enter | space | right | l | tab)
        if (( narrow )); then show_item "$cursor"; fi
        focus_content ;;
      btab) focus_content; bfocus=$(( nb - 1 )) ;;
    esac
  else
    case $K in
      up | k) scroll -1 ;;
      down | j) scroll 1 ;;
      home) cscroll=0 ;; end) cscroll=9999 ;;
      esc | left | h) focus_list ;;
      tab)
        if (( bfocus + 1 < nb )); then bfocus=$(( bfocus + 1 )) reveal=1
        elif (( narrow )); then bfocus=0 reveal=1
        else focus_list
        fi ;;
      btab)
        if (( bfocus > 0 )); then bfocus=$(( bfocus - 1 )) reveal=1
        elif (( narrow )); then bfocus=$(( nb - 1 )) reveal=1
        else focus_list
        fi ;;
      enter | space)
        if (( bfocus < 0 || bfocus >= nb )); then bfocus=0 reveal=1
        elif (( BLINE[bfocus] < CV[0] || BLINE[bfocus] >= CV[0] + CV[1] )); then reveal=1
        else press "$bfocus"
        fi ;;
    esac
  fi
}

# ── Main loop ────────────────────────────────────────────────────────────────
tty_init
term_size
render
while :; do
  read_key || { check_signal; do_quit; }
  check_signal
  if (( resized )); then resized=0; term_size; render; fi
  case $K in
    timeout | unknown | '') continue ;;
    mouse)
      if (( MB & 32 )) && ! (( MB & 64 )); then
        old=$hover; on_mouse
        [[ $hover == "$old" ]] && continue
      else
        on_mouse
      fi ;;
    *)
      if (( cols < 40 || rows < 19 )); then
        [[ $K == q || $K == Q ]] && do_quit
      elif [[ $screen == welcome ]]; then
        case $K in
          enter | space) screen=main; show_item 0 ;;
          q | Q) do_quit ;;
        esac
      else
        on_key_main
      fi ;;
  esac
  render
done
